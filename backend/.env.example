# Server Configuration
PORT=8080
DEBUG=false

# JWT Authentication
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secure-secret-key-here

# Database Configuration
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_NAME=HelloWorld

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Proxy Configuration (comma-separated list of trusted proxy IPs)
# Only set this if running behind a reverse proxy (nginx, etc.)
FORWARDED_ALLOW_IPS=127.0.0.1

# API Root Path (optional, for reverse proxy setups)
# ROOT_PATH=/api
